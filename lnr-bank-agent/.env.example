# Ключ авторизации GigaChat API (Authorization key из личного кабинета)
GIGACHAT_CREDENTIALS=
# Для физлиц — GIGACHAT_API_PERS
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Telegram-бот из @BotFather и id чата получателя
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Необязательно: путь к CA-бандлу (по умолчанию data/certs/ca-bundle.pem)
LNRBANK_CA_BUNDLE=
