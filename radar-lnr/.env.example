# ===== Скопируй в .env и заполни. .env НЕ коммитится (см. .gitignore) =====

# --- Telegram-бот (получить у @BotFather) ---
BOT_TOKEN=
# Твой user_id (узнать командой /myid у бота). Получает служебные уведомления.
ADMIN_USER_ID=
# user_id всех 5 пользователей через запятую (включая тебя)
ALLOWED_USER_IDS=
# Куда слать дайджест: id группы (отрицательное число, напр. -1001234567890)
# и/или личные user_id, через запятую. Личные можно отключить командой /mute.
DIGEST_CHAT_IDS=

# --- LLM (ключ от стороннего прокси-сервиса) ---
# anthropic — SDK anthropic с base_url; openai — SDK openai с base_url
LLM_API_FORMAT=anthropic
LLM_API_KEY=
LLM_BASE_URL=
# bearer (Authorization: Bearer) или x-api-key — только для формата anthropic
LLM_AUTH_STYLE=bearer
# Названия моделей — как их называет твой сервис
MODEL_FILTER=
MODEL_ANALYZE=

# --- Обогащение (этап 2) ---
DADATA_API_KEY=
DADATA_SECRET=

# --- Прочее ---
# Папка для SQLite, логов и выгрузок (в Docker — /data)
DATA_DIR=./data
# Включить запасной сбор через Telethon (нужен отдельный аккаунт)
USE_TELETHON=false
TELETHON_API_ID=
TELETHON_API_HASH=
