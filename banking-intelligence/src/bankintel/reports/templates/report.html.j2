{% macro catalog_table(items, is_deposit) %}
<table><tr><th>Банк</th><th>Продукт</th><th>Ставка (сайт)</th>{% if is_deposit %}<th>Срок</th>{% endif %}<th>Сумма</th><th>Пометки</th><th>ЛНР</th><th>Проверено</th></tr>
{% for p in items %}<tr><td>{{ p.bank }}</td><td>{% if p.product_url %}<a href="{{ p.product_url }}">{{ p.name }}</a>{% else %}{{ p.name }}{% endif %}</td>
<td>{{ p.rate_text or '—' }}{% if p.base_rate_max %}<br><span class="muted">базовая {{ p.base_rate_max | pct }}</span>{% endif %}</td>
{% if is_deposit %}<td>{{ p.term_text or '—' }}</td>{% endif %}
<td>{% if p.amount_min %}от {{ p.amount_min | money }}{% endif %}{% if p.amount_max %} до {{ p.amount_max | money }}{% endif %}{% if p.currency and p.currency != 'RUB' %} ({{ p.currency }}){% endif %}{% if not p.amount_min and not p.amount_max %}—{% endif %}</td>
<td>{% if 'restricted_audience' in p.flags %}<span class="chip">особые условия</span>{% endif %}{% if 'floating_rate' in p.flags %}<span class="chip">плавающая</span>{% endif %}{% if 'limited_time' in p.flags %}<span class="chip">ограничено по времени</span>{% endif %}{% if 'ai_assisted' in p.flags %}<span class="chip">часть данных — AI (цитата проверена)</span>{% endif %}{% if 'sources_conflict' in p.flags %}<span class="chip">источники расходятся</span>{% endif %}</td>
<td>{{ {'confirmed':'подтверждена','unavailable':'недоступен','not_confirmed':'не подтверждена','unknown':'неизвестно'}[p.lnr_status] }}</td><td>{{ p.checked_at | date }}</td></tr>{% endfor %}</table>
{% endmacro %}
<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Анализ вкладов ПСБ и ВТБ</title>
<style>
  :root { color-scheme: light; --surface:#fcfcfb; --card:#ffffff; --ink:#0b0b0b; --ink2:#52514e; --muted:#6d6c68; --line:#e3e2dd;
          --warn-bg:#fff4e0; --warn-ink:#7a4a00; --chip:#eeeeea; }
  * { box-sizing: border-box; }
  body { margin:0; background:var(--surface); color:var(--ink); font:14px/1.5 "DejaVu Sans","Liberation Sans",Arial,sans-serif; }
  main { max-width: 1100px; margin: 0 auto; padding: 24px 16px 48px; }
  h1 { font-size: 24px; margin: 0 0 4px; } h2 { font-size: 18px; margin: 32px 0 8px; border-bottom:1px solid var(--line); padding-bottom:4px; }
  h3 { font-size: 15px; margin: 20px 0 6px; } p { margin: 6px 0; } .muted { color: var(--muted); font-size: 12px; }
  .banner { background: var(--warn-bg); color: var(--warn-ink); border-radius: 8px; padding: 10px 14px; margin: 14px 0; }
  .kpis { display:flex; flex-wrap:wrap; gap:10px; margin:14px 0; }
  .kpi { flex:1 1 200px; background:var(--card); border:1px solid var(--line); border-radius:10px; padding:10px 14px; }
  .kpi .v { font-size: 28px; font-weight: 700; line-height:1.2; } .kpi .l { color:var(--ink2); font-size:12px; }
  table { border-collapse: collapse; width: 100%; background: var(--card); font-size: 12.5px; margin: 8px 0; }
  th, td { border-bottom: 1px solid var(--line); padding: 5px 8px; text-align: left; vertical-align: top; }
  th { background: var(--chip); font-weight: 600; } td.num, th.num { text-align: right; white-space: nowrap; }
  .chip { display:inline-block; background:var(--chip); border-radius:10px; padding:0 8px; font-size:11px; margin-right:4px; white-space:nowrap; }
  .legend { display:flex; flex-wrap:wrap; gap:14px; font-size:12px; color:var(--ink2); margin:6px 0 2px; }
  .sw { display:inline-block; width:10px; height:10px; border-radius:2px; margin-right:5px; vertical-align:-1px; }
  .chart { background:var(--card); border:1px solid var(--line); border-radius:10px; padding:10px; }
  {% if mode == 'html' %}.chart { overflow-x:auto; }{% endif %}
  ul { margin: 6px 0 6px 18px; padding: 0; } li { margin: 3px 0; }
  details > summary { cursor: pointer; color: var(--ink2); }
  a { color: #2a78d6; word-break: break-all; } code { font-size: 11px; }
  {% if mode == 'pdf' %}
  @page { size: A4 landscape; margin: 14mm 12mm 16mm; @bottom-left { content: "Banking Intelligence AI · набор данных {{ ds.meta.dataset_id }} · демо-прототип"; font-size: 8pt; color: #6d6c68; }
          @bottom-right { content: "стр. " counter(page) " из " counter(pages); font-size: 8pt; color: #6d6c68; } }
  body { font-size: 10.5pt; } main { max-width: none; padding: 0; } h2 { break-after: avoid; } h3 { break-after: avoid; }
  .chart, .kpi, tr { break-inside: avoid; } .scenario { break-before: page; } a { word-break: break-all; }
  {% endif %}
</style>
</head>
<body>
<main>
  <h1>Конкурентный анализ вкладов и накопительных счетов — {{ ds.meta.region }}</h1>
  <p class="muted">Сформировано {{ ds.meta.generated_at | dt }} · данные от {{ ds.meta.data_from | date }}{% if ds.meta.data_to | date != ds.meta.data_from | date %} – {{ ds.meta.data_to | date }}{% endif %} ·
    набор данных <code>{{ ds.meta.dataset_id }}</code> · версия {{ ds.meta.app_version }}</p>
  <div class="banner"><b>Демо-прототип.</b> Охвачены {{ ds.meta.banks_with_data }} из {{ ds.meta.banks_total }} банков реестра; данных Сбербанка (эталона) нет;
    доступность продуктов в ЛНР подтверждена у {{ ds.meta.lnr_confirmed }} из {{ ds.meta.products_total }} продуктов.</div>

  <div class="kpis">
    <div class="kpi"><div class="v">{{ ds.meta.banks_with_data }} из {{ ds.meta.banks_total }}</div><div class="l">банков с данными</div></div>
    <div class="kpi"><div class="v">{{ ds.catalog.deposit | length }} + {{ ds.catalog.savings | length }}</div><div class="l">вкладов + накопительных счетов</div></div>
    <div class="kpi"><div class="v">{{ ds.meta.lnr_confirmed }} из {{ ds.meta.products_total }}</div><div class="l">доступность в ЛНР подтверждена</div></div>
    <div class="kpi"><div class="v">{{ ds.sources | length }}</div><div class="l">сохранённых документов-источников</div></div>
  </div>

  <h2>Главное</h2>
  <ul>{% for t in ds.insights %}<li>{{ t }}</li>{% endfor %}</ul>
  <p class="muted">Это сравнение верхних границ дохода по данным сайтов; ставка для конкретного клиента зависит от условий. Ограничения — в конце отчёта.</p>

  <h2>Охват данных</h2>
  <table><tr><th>Банк</th><th>Статус</th><th class="num">Вклады</th><th class="num">Счета</th><th>Причина / последняя загрузка</th></tr>
  {% for c in ds.coverage %}<tr>
    <td>{{ c.name }}{% if c.is_benchmark %} <span class="chip">эталон</span>{% endif %}</td>
    <td>{{ 'есть данные' if c.status == 'data' else 'нет данных' }}</td><td class="num">{{ c.deposits }}</td><td class="num">{{ c.savings }}</td>
    <td>{% if c.reason %}{{ c.reason }}{% endif %}{% if c.last_fetch %}<br><span class="muted">загрузка {{ c.last_fetch.at | dt }}: {{ c.last_fetch.outcome }}</span>{% endif %}</td>
  </tr>{% endfor %}</table>

  <h2>Сценарии: доход за срок</h2>
  <p class="muted">Простой процент по номинальной ставке сайта, до налогов, без капитализации. Интервал: от минимальной до максимальной ставки сайта; «до» — нижняя граница не указана.
    Штриховка — предложение не для всех клиентов.</p>
  {% for s in ds.scenarios %}
  <section class="scenario">
    <h3>{{ s.label }} ({{ s.days }} дн.)</h3>
    {% if charts[loop.index0].rows %}
    <div class="legend">{% for it in charts[loop.index0].legend %}<span><i class="sw" style="background:{{ it.color }}"></i>{{ it.bank }}</span>{% endfor %}
      <span><svg width="12" height="12" viewBox="0 0 12 12" style="vertical-align:-2px;margin-right:5px"><rect width="12" height="12" rx="2" fill="#fcfcfb" stroke="#8a8984"/><path d="M0 12L12 0M-3 9L9 -3M3 15L15 3" stroke="#8a8984" stroke-width="1.6"/></svg>особые условия</span><span>● верхняя граница (○ — особые условия)</span></div>
    <div class="chart">{{ charts[loop.index0].html | safe }}</div>
    {% else %}<p>Подходящих продуктов в этом сценарии нет.</p>{% endif %}
    <table><tr><th>Банк</th><th>Продукт</th><th>Ставка (сайт)</th><th>Срок</th><th class="num">Доход, ₽</th><th>Пометки</th></tr>
    {% for r in s.open + s.restricted %}{% if loop.index <= 12 %}<tr>
      <td>{{ r.bank }}</td><td>{{ r.name }}</td><td>{{ r.rate_text or '—' }}</td><td>{{ r.term_text or '—' }}</td>
      <td class="num">{% if r.income_min and r.income_min != r.income_max %}{{ r.income_min | money }} – {% elif not r.income_min %}до {% endif %}{{ r.income_max | money }}{% if r.rate_applied %}<br><span class="muted">точная ставка {{ r.rate_applied | pct }}</span>{% endif %}</td>
      <td>{% if r in s.restricted %}<span class="chip">особые условия</span>{% endif %}{% if 'floating_rate' in r.flags %}<span class="chip">плавающая</span>{% endif %}{% if 'limited_time' in r.flags %}<span class="chip">ограничено по времени</span>{% endif %}</td></tr>{% endif %}{% endfor %}</table>
    {% for n in s.banks_without_data %}{% if loop.first %}<p class="muted">Нет данных по банкам: {% endif %}{{ n }}{% if not loop.last %}, {% else %}.</p>{% endif %}{% endfor %}
    {% if s.excluded %}<details {{ 'open' if mode == 'pdf' }}><summary>Исключено из сценария: {{ s.excluded | length }}</summary>
      <ul>{% for e in s.excluded %}<li>{{ e.bank }} · {{ e.name }} — {{ e.reason }}</li>{% endfor %}</ul></details>{% endif %}
  </section>
  {% endfor %}

  <h2>Изменения за {{ ds.changes.window_days }} дней</h2>
  <p class="muted">Наблюдение ведётся с {{ ds.changes.monitoring.since | dt }}; сравнений с предыдущим запуском: {{ ds.changes.monitoring.comparisons }}.
    {% if not ds.changes.monitoring.comparisons %}Пока это базовая линия (первый сбор) — изменения появятся после следующего запуска.{% endif %}</p>
  {% if ds.changes['items'] %}
  <table><tr><th>Когда</th><th>Банк</th><th>Продукт</th><th>Тип</th><th>Значимость</th><th>Что изменилось</th></tr>
  {% for c in ds.changes['items'] %}<tr><td>{{ c.detected_at | dt }}</td><td>{{ c.bank }}</td><td>{{ c.product }}</td>
    <td>{{ {'new':'новый','removed':'исчез','changed':'изменён'}[c.type] }}</td>
    <td>{{ {'rate':'ставка/срок/сумма','conditions':'условия','info':'прочее'}[c.severity] }}</td><td>{{ c.text }}</td></tr>{% endfor %}</table>
  {% else %}<p>Изменений за период не обнаружено.</p>{% endif %}

  <h2>Каталог вкладов</h2>
  {{ catalog_table(ds.catalog.deposit, true) }}
  <h2>Каталог накопительных счетов</h2>
  {{ catalog_table(ds.catalog.savings, false) }}
  <p class="muted">«До X%» у счетов — максимум при выполнении условий банка (бонусы, временные периоды). Доход по счетам не рассчитывается.</p>

  <h2>Источники</h2>
  <table><tr><th>Банк</th><th>Документ</th><th>Получен</th><th>Происхождение</th><th>SHA-256</th></tr>
  {% for d in ds.sources %}<tr><td>{{ d.bank }}</td><td><a href="{{ d.url }}">{{ d.url }}</a></td><td>{{ d.fetched_at | dt }}</td>
    <td>{{ 'загружен автоматически' if d.origin == 'fetched' else 'внесён вручную' }}</td><td><code>{{ d.sha256[:12] }}</code></td></tr>{% endfor %}</table>

  <h2>Методика</h2><ul>{% for t in ds.methodology %}<li>{{ t }}</li>{% endfor %}</ul>
  <h2>Ограничения</h2><ul>{% for t in ds.limitations %}<li>{{ t }}</li>{% endfor %}</ul>
</main>
</body>
</html>
