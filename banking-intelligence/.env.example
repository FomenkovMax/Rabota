# Скопируйте в .env и заполните. Файл .env в git НЕ попадает.
# Комментарии — только на отдельных строках: docker compose трактует «# ...» после значения как часть значения.

# Токен бота от @BotFather.
BOT_TOKEN=
# Telegram ID пользователей через запятую. Пусто = бот никому не отвечает.
ALLOWED_TELEGRAM_IDS=
# Пароль БД для docker compose. Обязателен: значения по умолчанию нет, compose не запустится без него.
POSTGRES_PASSWORD=
# Строка подключения при запуске без Docker (в Docker compose собирает её сам).
DATABASE_URL=
# Каталог для исходных документов.
RAW_STORAGE_DIR=data/raw
# Доп. корневые сертификаты (PEM) для сайтов, чей CA отсутствует в стандартном наборе; проверка сертификатов НЕ отключается.
EXTRA_CA_BUNDLE=certs/russian_trusted_root_ca.pem
FETCH_MIN_INTERVAL_S=2
LOG_LEVEL=INFO
LOG_JSON=false
# Мониторинг изменений (этап 6).
REDIS_URL=redis://localhost:6379/0
MONITOR_INTERVAL_HOURS=6
# true = рассылать значимые изменения пользователям из ALLOWED_TELEGRAM_IDS.
NOTIFY_CHANGES=false
# Этап 3 (AI-извлечение), пока не используется.
OPENAI_API_KEY=
