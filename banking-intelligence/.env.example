# Скопируйте в .env и заполните. Файл .env в git НЕ попадает.
BOT_TOKEN=                       # токен от @BotFather
ALLOWED_TELEGRAM_IDS=            # через запятую; пусто = бот никому не отвечает
DATABASE_URL=postgresql+asyncpg://bankintel:bankintel@localhost:5432/bankintel
RAW_STORAGE_DIR=data/raw         # где хранятся исходные документы
# Доп. корневые сертификаты (PEM), если CA сайта банка нет в стандартном наборе.
# Проверка сертификатов НЕ отключается. Файл получите из официального источника.
EXTRA_CA_BUNDLE=certs/russian_trusted_root_ca.pem
FETCH_MIN_INTERVAL_S=2
# Мониторинг изменений (этап 6)
REDIS_URL=redis://localhost:6379/0
MONITOR_INTERVAL_HOURS=6
NOTIFY_CHANGES=false             # true = рассылать значимые изменения пользователям из ALLOWED_TELEGRAM_IDS
# Этап 3 (AI-извлечение), пока не используется:
OPENAI_API_KEY=
