__pycache__/
*.pyc
.venv/
venv/
.env

# Папка data закрыта целиком, а не по списку расширений.
# Репозиторий публичный, и сюда кладут выгрузки с внутренними условиями
# по продуктам. Перечислять запрещённые имена — значит однажды не угадать:
# файл, названный иначе, чем ожидалось, уехал бы в публичный доступ.
# Поэтому по умолчанию запрещено всё, а разрешения перечислены явно.
data/*
!data/.gitkeep
!data/sber_example.xlsx
