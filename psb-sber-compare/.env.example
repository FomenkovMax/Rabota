# Скопируй в .env и заполни. Файл .env в git не попадает.

# Токен бота от @BotFather
BOT_TOKEN=

# Кому открыт бот — Telegram ID через запятую.
# Свой ID узнаешь у @userinfobot. Без этого списка бот не стартует:
# он показывает внутреннюю аналитику, и открытый доступ по умолчанию
# был бы плохой настройкой по умолчанию.
BOT_ALLOWED_IDS=

# Ключ для AI-консультанта: console.anthropic.com
ANTHROPIC_API_KEY=
