# Скопируй в .env и заполни. Файл .env в git не попадает.

# --- Telegram -------------------------------------------------------------

# Токен бота от @BotFather.
# ВАЖНО: токен состоит из двух частей через двоеточие — номер бота и длинный
# хвост. Одного номера недостаточно, Telegram такой токен отклонит.
# Правильно:  8861325560:AAHdqTcvCH1vGWJxfSeofSAs0K5PALDsaw
BOT_TOKEN=

# Кому открыт бот — Telegram ID через запятую, без пробелов.
# Свой ID узнаешь у @userinfobot или командой /id у самого бота.
# Без этого списка бот не стартует: он показывает внутреннюю аналитику,
# и открытый доступ по умолчанию был бы плохой настройкой по умолчанию.
BOT_ALLOWED_IDS=

# --- AI-консультант -------------------------------------------------------

# Ключ доступа к модели. Официальные ключи Anthropic начинаются
# с sk-ant-api03-, у посредников формат свой.
# Оставь пустым, если консультант пока не нужен: бот запустится,
# просто эта кнопка будет отвечать понятной ошибкой.
ANTHROPIC_API_KEY=

# Адрес API. Пусто — официальный Anthropic (api.anthropic.com).
# Если ключ куплен у посредника, впиши его Base URL, например:
#   ANTHROPIC_BASE_URL=https://ai.starimg.ru
ANTHROPIC_BASE_URL=

# Модель. Пусто — claude-opus-5.
# У посредников набор моделей свой, и нужной может не быть — тогда
# посмотри их список доступных моделей и впиши оттуда, например:
#   AI_MODEL=claude-sonnet-5
AI_MODEL=
