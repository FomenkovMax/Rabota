# Токен от @BotFather
BOT_TOKEN=
# Ключ Anthropic API (console.anthropic.com)
ANTHROPIC_API_KEY=
# Нужно только если ключ куплен у стороннего провайдера (пример — Anthropic-формат LiteAI).
# Для официального API оставь закомментированным.
# ANTHROPIC_BASE_URL=https://api.liteai.tech/anthropic
# Если провайдер отвечает 401 на обычный ключ — попробуй: ANTHROPIC_AUTH_MODE=bearer
# ANTHROPIC_AUTH_MODE=x-api-key
# Модель для судьи и генератора вопросов
CLAUDE_MODEL=claude-sonnet-5-5
# Модель только для генерации вопросов (можно взять сильнее, чем для судьи). Пусто — как CLAUDE_MODEL.
# GEN_MODEL=claude-opus-5-5
# Твой Telegram ID (узнать у @userinfobot) — для админ-команды /gen
ADMIN_ID=0
# Кому разрешён доступ (через запятую, Telegram ID). Пусто — бот открыт всем. Админ допущен всегда.
# В боте чужие авторские вопросы — для команды лучше закрыть доступ.
# ALLOWED_IDS=703699295,111111111
# Группы, где играть может любой участник (id группы покажет команда /myid, это отрицательное число).
# ALLOWED_CHATS=-1001234567890
# Командная игра (спортивное ЧГК): 3 тура по 12 вопросов, у капитана 20 сек на сдачу ответа.
# TEAM_TOURS=3
# TEAM_PER_TOUR=12
# TEAM_ANSWER_SECONDS=20
# Скрывать вопросы, которые берут почти все или почти никто (при достаточном числе ответов).
# HIDE_MIN_ANSWERS=6
# HIDE_LO=0.10
# HIDE_HI=0.90
# Модель для кнопки «Разбор по шагам». Пусто — как CLAUDE_MODEL (быстрее). Можно взять сильнее, если провайдер не тормозит.
# STEPS_MODEL=claude-sonnet-5
# Сколько секунд ждать оценки ответа от модели, прежде чем перейти на запасной режим (точное совпадение).
# JUDGE_TIMEOUT=35
# Где хранятся база вопросов и статистика
DATA_DIR=./data
