{$PUBLIC_HOST} {
	encode gzip
	handle /api/* {
		reverse_proxy backend:8000
	}
	# главная страница Mini App не кешируется: иначе Telegram показывает старую версию после обновления.
	# Сборочные файлы (/assets/index-<хеш>.js|css) меняют имя при каждой сборке — их кешировать безопасно.
	@page path / /index.html
	header @page Cache-Control "no-cache, no-store, must-revalidate"
	@hashed path_regexp ^/assets/index-[A-Za-z0-9_-]+\.(js|css)$
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
